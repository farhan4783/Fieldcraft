# Server Configuration
PORT=3000
NODE_ENV=development

# Ollama / Local Gemma Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
# Fallback model if 4b is too heavy: gemma3:1b

# OpenStreetMap / Overpass Configuration
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT_MS=10000

# Game & Geofence Defaults (in meters)
GEOFENCE_ARRIVAL_RADIUS_METERS=90
GEOFENCE_ACCURACY_THRESHOLD_METERS=60
GEOFENCE_MIN_QUALIFYING_READINGS=2
