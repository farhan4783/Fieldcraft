# Server Configuration
PORT=3000
NODE_ENV=development

# Cloud AI Provider Options (Set ONE of these for Cloud AI without local Ollama)
# 1. Groq (Recommended: Free & runs Gemma 2 open models at 500+ tokens/sec)
# Get free key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=gemma2-9b-it

# 3. OpenRouter API (Free & paid models at https://openrouter.ai)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-2-9b-it:free

# Local Ollama / Gemma Configuration (Used if running locally)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# OpenStreetMap / Overpass Configuration
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT_MS=12000

# Game & Geofence Defaults (in meters)
GEOFENCE_ARRIVAL_RADIUS_METERS=90
GEOFENCE_ACCURACY_THRESHOLD_METERS=100
GEOFENCE_MIN_QUALIFYING_READINGS=2
